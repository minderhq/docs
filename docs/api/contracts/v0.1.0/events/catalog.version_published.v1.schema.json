{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindhub.invalid/contracts/events/catalog.version_published.v1.schema.json",
  "title": "catalog.version_published v1 (data)",
  "description": "Emitted when a draft version is published. Its requirements, provides and releases are immutable from then on.",
  "type": "object",
  "required": [
    "product_id",
    "version",
    "channel",
    "minder_versions",
    "provides",
    "digests"
  ],
  "additionalProperties": false,
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^(?:plugin|bundle|agent|service|application|knowledge\\-base|ai\\-capability|cloud\\-capability|add\\-on)\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "version": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "minder_versions": {
      "type": "string"
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+@(?:0|[1-9]\\d*)$"
      }
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
